{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SoniQ Batch File",
  "description": "Batch download specification for SoniQ.",
  "type": "object",
  "properties": {
    "songs": {
      "description": "List of songs to download.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artist", "title"],
        "properties": {
          "artist": {
            "description": "Artist or band name.",
            "type": "string",
            "examples": ["Bruno Mars", "Radiohead", "Googoosh"]
          },
          "title": {
            "description": "Song title.",
            "type": "string",
            "examples": ["Just the Way You Are", "Creep"]
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "output_dir": {
          "description": "Directory to save downloaded files.",
          "type": "string",
          "default": "~/Music/SoniQ"
        }
      }
    }
  },
  "required": ["songs"]
}
